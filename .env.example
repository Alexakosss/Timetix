# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token.
# Never commit the real token. Required unless you only use --check-only/--baseline.
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: the server (guild) where slash commands should be registered.
# Guild commands appear instantly; global commands can take up to an hour.
GUILD_ID=1401229550477643828

# The channel where announcements are posted.
CHANNEL_ID=1562468346639687741

# Optional: when set, ALL announcements go here instead of CHANNEL_ID.
# Useful while testing in a private channel.
TEST_CHANNEL_ID=1450544317679800391

# ---------------------------------------------------------------------------
# Safety switches
# ---------------------------------------------------------------------------
# true  = download and log everything, but never post to Discord (default)
# false = actually post announcements (requires CHANNEL_ID or TEST_CHANNEL_ID)
DRY_RUN=true

# true  = on the very first check, record the current PDFs without posting them
BASELINE_ON_FIRST_RUN=true

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Official timetable page (defaults to the 1ο ΕΠΑΛ Αιγάλεω page).
TIMETABLE_URL=http://1epal-aigal.att.sch.gr/sched-stud/

# Recommended: 5-10.
CHECK_INTERVAL_MINUTES=7

REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
MAX_DOWNLOAD_MB=50

# Set to false only if the school server has a broken TLS certificate.
VERIFY_SSL=true

# Optional HTTP User-Agent override.
# USER_AGENT=SchoolTimetableBot/1.0 (+https://example.org/)

# ---------------------------------------------------------------------------
# Discord attachments
# ---------------------------------------------------------------------------
# Hard cap used before uploading. The bot also respects the guild's own limit.
DISCORD_MAX_ATTACHMENT_MB=10

# ---------------------------------------------------------------------------
# Optional large-file hosting (only used when a PDF exceeds the limit)
# ---------------------------------------------------------------------------
# Serve PUBLIC_DIR from a web server and set the public base URL, e.g.
# PUBLIC_FILE_BASE_URL=https://files.example.org/timetables
# PUBLIC_DIR=public/timetables

# ---------------------------------------------------------------------------
# Storage / logging
# ---------------------------------------------------------------------------
DATABASE_PATH=data/timetables.sqlite3
DOWNLOAD_DIR=data/downloads
LOG_DIR=logs
LOG_LEVEL=INFO
