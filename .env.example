# Discord Bot Configuration
# Copy this file to .env and fill in your values

# ========================
# Discord
# ========================

# Your Discord bot token (get from https://discord.com/developers/applications)
# Required for running the bot
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Guild (Server) ID for instant slash command sync
# Right click your server -> Copy Server ID (Developer Mode must be enabled)
# Leave empty to use global commands (can take up to 1 hour to appear)
GUILD_ID=

# Default channel ID where announcements will be posted
# Right click the channel -> Copy Channel ID
# If using /setup per server, this is only used as fallback
CHANNEL_ID=

# Testing channel ID - when set, ALL announcements go here instead of CHANNEL_ID
# Great for testing before going live
TEST_CHANNEL_ID=

# ========================
# Safety Settings
# ========================

# DRY_RUN=true  -> Bot will check, download, hash and log everything but NOT post to Discord
# DRY_RUN=false -> Bot WILL post announcements to Discord
# Keep as true until you're ready to go live
DRY_RUN=true

# BASELINE_ON_FIRST_RUN=true -> On first check, record existing timetables without posting
# This prevents spamming old files when you first run the bot
BASELINE_ON_FIRST_RUN=true

# ========================
# Timetable Monitoring
# ========================

# URL of the timetable page to monitor
# Default is 1o EPAL Aigaleo, you can change this for other schools
TIMETABLE_URL=http://1epal-aigal.att.sch.gr/sched-stud/

# How often to check for updates (in minutes)
# Recommended between 5 and 10
CHECK_INTERVAL_MINUTES=7

# HTTP request settings
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# Maximum file size to download (in MB)
MAX_DOWNLOAD_MB=50

# Verify SSL certificates (set to false only if the school website has broken HTTPS)
VERIFY_SSL=true

# Custom User-Agent (optional)
# USER_AGENT=TimetableBot/1.0

# ========================
# Discord Attachments
# ========================

# Maximum size for direct file attachments (in MB)
# The bot also respects your server's upload limit automatically
DISCORD_MAX_ATTACHMENT_MB=10

# ========================
# Large File Hosting (Optional)
# ========================

# If a PDF is too large for Discord, you can host it yourself
# Set PUBLIC_FILE_BASE_URL to your public URL and PUBLIC_DIR to the local folder
# Example: PUBLIC_FILE_BASE_URL=https://files.example.com/timetables
# PUBLIC_DIR=public/timetables

PUBLIC_FILE_BASE_URL=
PUBLIC_DIR=

# ========================
# Storage & Logging
# ========================

# Paths for data storage (relative to project folder or absolute)
DATABASE_PATH=data/timetables.sqlite3
DOWNLOAD_DIR=data/downloads
LOG_DIR=logs

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
